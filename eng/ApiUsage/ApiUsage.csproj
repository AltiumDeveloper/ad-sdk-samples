<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Extracts, with the C# compiler's semantic model, every SDK type and member a sample's own code uses.
    Run by eng/build-index.mjs with its api option; arguments: the sample folders, then optionally an out file.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>
</Project>
