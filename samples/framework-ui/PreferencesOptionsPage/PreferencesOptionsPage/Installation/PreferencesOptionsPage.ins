ClientInsFile 1.0

Server
    EditorName        = 'PreferencesOptionsPage'
    EditorExePath     = 'PreferencesOptionsPage.DLL'
    EditorDescription = 'Add a Preferences page and persist its options'
    Version           = 'Version 1.0.0.0'
    Date              = '11/13/2026'
    HelpAboutInfo     = 'Altium Designer SDK sample.'
    Copyright         = 'Copyright Altium Limited'
    // Merge this extension's menus at startup. Without it, AD merges them only when the server first starts,
    // after the menu bar is built: no top-level menu.
    Updates           = 'AdvSch'
End

// The Preferences page. A category of this server with one page; FormName is the name the shim passes to
// RegisterOptionsPageCreator (PreferencesPage.cs). The block follows
// the form of AD's own TextEdit.ins (category, then nested pages). No ServerImage/Image: the sample ships no icon.
// No SystemExtension: AD has to start the server before the page can be created.
OptionsPage
    ServerName  = 'PreferencesOptionsPage'
    Caption     = 'PreferencesOptionsPage'
    OrderIndex  = 9000

    OptionsPage
        Caption    = 'General'
        FormName   = 'General'
        OrderIndex = 1

        Keywords
            'temperature sample preferences'
        End
    End
End

// Generic, stable processes. Features are [HotCommand] methods reached through Run with Cmd=<Name>.
// "#if DEBUG" blocks are kept in Debug builds only (Directory.Build.targets).
Command Name = 'Run'    LongSummary = 'Run a command of PreferencesOptionsPage (Params: Cmd=<Name>|...)' End
#if DEBUG
Command Name = 'Reload' LongSummary = 'Reload the PreferencesOptionsPage implementation module'        End
Command Name = 'Status' LongSummary = 'Show PreferencesOptionsPage hot reload status'                  End
#endif
