ClientInsFile 1.0

Server
    EditorName        = 'WebBrowserPanel'
    EditorExePath     = 'WebBrowserPanel.DLL'
    EditorDescription = 'Show a web page in a dockable panel'
    Version           = 'Version 1.0.0.0'
    Date              = '11/13/2026'
    HelpAboutInfo     = 'Altium Designer SDK sample.'
    Copyright         = 'Copyright Altium Limited'
    // Merge this extension's menus at startup. Without it, AD merges them only when the server first starts,
    // after the menu bar is built: no top-level menu.
    Updates           = 'AdvSch'
End

// Generic, stable processes. Features are [HotCommand] methods reached through Run with Cmd=<Name>.
// "#if DEBUG" blocks are kept in Debug builds only (Directory.Build.targets).
Command Name = 'Run'    LongSummary = 'Run a command of WebBrowserPanel (Params: Cmd=<Name>|...)' End
#if DEBUG
Command Name = 'Reload' LongSummary = 'Reload the WebBrowserPanel implementation module'        End
Command Name = 'Status' LongSummary = 'Show WebBrowserPanel hot reload status'                  End
#endif

PanelInfo
    // The WebBrowserPanel panel (framework\shim\Panel.cs). Its content comes from the implementation, so it hot-reloads;
    // this block needs a redeploy and an AD restart.
    Name              = 'WebBrowserPanelPanel'
    Category          = 'WebBrowserPanel'
    Bitmap            = ''
    Hotkey            = ''
    ButtonVisible     = True
    CanDockVertical   = True
    CanDockHorizontal = True
End
