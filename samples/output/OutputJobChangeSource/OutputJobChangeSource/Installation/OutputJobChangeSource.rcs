PL PLOutputJobChangeSource:ChangeOutputJobFile
    Command='OutputJobChangeSource:Run'
    Caption='&Change Output Job File'
    Image=''
    Description='Redirect an OutJob outputer to another source document'
    Params='Cmd=ChangeOutputJobFile'
End

PL PLOutputJobChangeSource:ListOutputJobOutputers
    Command='OutputJobChangeSource:Run'
    Caption='&List Output Job Outputers'
    Image=''
    Description='List an Output Job''s outputers and their source documents'
    Params='Cmd=ListOutputJobOutputers'
End

