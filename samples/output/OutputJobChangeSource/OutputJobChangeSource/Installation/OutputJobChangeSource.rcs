Tree MNOutputJobChangeSource Caption='&OutputJobChangeSource' TopLevel=True
    Link      MNOutputJobChangeSource_ChangeOutputJobFile  PLID='PLOutputJobChangeSource:ChangeOutputJobFile'  End
    Link      MNOutputJobChangeSource_ListOutputJobOutputers  PLID='PLOutputJobChangeSource:ListOutputJobOutputers'  End
#if DEBUG
    Separator MNOutputJobChangeSource_Sep10                              End
    Tree MNOutputJobChangeSource_Developer Caption='&Developer'
        Link  MNOutputJobChangeSource_Reload PLID='PLOutputJobChangeSource:Reload' End
        Link  MNOutputJobChangeSource_Status PLID='PLOutputJobChangeSource:Status' End
    End
#endif
End

Insertion MNOutputJobChangeSource_1 TargetID='MNNoDocument' InsertType='Before' RefID0='MNNoDocument_Window'
    TreeCopy MNNoDocument_OutputJobChangeSource OriginalID=MNOutputJobChangeSource IDSuffix='_1' End
End
Insertion MNOutputJobChangeSource_2 TargetID='MNSchematicMenu' InsertType='Before' RefID0='MNSchematic_Window1'
