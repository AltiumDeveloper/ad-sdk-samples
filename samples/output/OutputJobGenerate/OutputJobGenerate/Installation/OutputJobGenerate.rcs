Tree MNOutputJobGenerate Caption='&OutputJobGenerate' TopLevel=True
    Link      MNOutputJobGenerate_RunOutputJobs  PLID='PLOutputJobGenerate:RunOutputJobs'  End
    Link      MNOutputJobGenerate_ListOutputMedia  PLID='PLOutputJobGenerate:ListOutputMedia'  End
#if DEBUG
    Separator MNOutputJobGenerate_Sep10                              End
    Tree MNOutputJobGenerate_Developer Caption='&Developer'
        Link  MNOutputJobGenerate_Reload PLID='PLOutputJobGenerate:Reload' End
        Link  MNOutputJobGenerate_Status PLID='PLOutputJobGenerate:Status' End
    End
#endif
End

Insertion MNOutputJobGenerate_1 TargetID='MNNoDocument' InsertType='Before' RefID0='MNNoDocument_Window'
    TreeCopy MNNoDocument_OutputJobGenerate OriginalID=MNOutputJobGenerate IDSuffix='_1' End
End
Insertion MNOutputJobGenerate_2 TargetID='MNSchematicMenu' InsertType='Before' RefID0='MNSchematic_Window1'
