ClientInsFile 1.0

Server
    EditorName        = 'WireAddParameter'
    EditorExePath     = 'WireAddParameter.DLL'
    EditorDescription = 'Add, read and remove parameters on a schematic wire'
    Version           = 'Version 1.0.0.0'
    Date              = '11/13/2026'
    HelpAboutInfo     = 'Altium Designer SDK sample.'
    Copyright         = 'Copyright Altium Limited'
    // Merge this extension's menus at startup. Without it, AD merges them only when the server first starts,
    // after the menu bar is built: no top-level menu.
    Updates           = 'AdvSch'
End

// Generic, stable processes. Features are [HotCommand] methods reached through Run with Cmd=<Name>.
// "#if DEBUG" blocks are kept in Debug builds only (Directory.Build.targets).
Command Name = 'Run'    LongSummary = 'Run a command of WireAddParameter (Params: Cmd=<Name>|...)' End
// Same as Run, but registered with a GetState that shows the item only while a wire is under the right-click
// position (WireContextMenu.cs). Used by the schematic context menu items in WireAddParameter.rcs.
Command Name = 'RunOnWire' LongSummary = 'Run a WireAddParameter command on the wire under the right-click cursor' End
#if DEBUG
Command Name = 'Reload' LongSummary = 'Reload the WireAddParameter implementation module'        End
Command Name = 'Status' LongSummary = 'Show WireAddParameter hot reload status'                  End
#endif
